# ============================================================
# .env.example
# 실제 사용 시 이 파일을 복사하여 `.env` 로 저장 후 값을 채우세요.
#   cp .env.example .env
#
# ⚠️  .env 파일은 절대 Git에 커밋하지 마세요.
#     .gitignore 에 `.env` 가 포함되어 있는지 확인하세요.
# ============================================================

# ── OpenAI API 설정 ─────────────────────────────────────────
# OpenAI 대시보드(https://platform.openai.com/api-keys)에서 발급
OPENAI_API_KEY=sk-proj-your_api_key_here

# 사용할 Chat 모델 (기본값: gpt-4o)
OPENAI_CHAT_MODEL=gpt-4o

# 사용할 임베딩 모델 (기본값: text-embedding-3-small)
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── MariaDB 접속 설정 ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ssd_reader          # SELECT 전용 계정
DB_PASSWORD=reader_pass     # 실제 비밀번호로 교체
DB_NAME=ssd_db

# ── Chroma 벡터 DB 설정 ─────────────────────────────────────
# 정상 패턴 문서가 저장될 로컬 디렉터리 경로
CHROMA_PERSIST=./chroma_db
